{
  "namespace": "hud",

  "score_label@common.label": {
    "text": "",
    "alpha": 0.0,
    "size": [ 0, 0 ],
    "visible": false
  },

  "tab_player_row": {
    "type": "panel",
    "size": [ "100%", 12 ],
    "controls": [
      {
        "name@scoreboard.sidebar_player_name": {
          "shadow": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 4, 1 ]
        }
      }
    ]
  },

  "java_tab_panel": {
    "type": "panel",
    "size": [ "65%", "75%" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 15 ],
    "controls": [
      {
        "bg@common.black_panel": {
          "alpha": 0.65,
          "size": [ "100%", "100%" ]
        }
      },
      {
        "content": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "95%", "95%" ],
          "offset": [ 0, 5 ],
          "controls": [
            {
              "tab_header@scoreboard.sidebar_title": {
                "shadow": true,
                "anchor_from": "top_middle",
                "anchor_to": "top_middle"
              }
            }
          ]
        }
      }
    ]
  }
}
