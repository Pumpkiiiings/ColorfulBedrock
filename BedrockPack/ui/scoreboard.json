{
  "namespace": "scoreboard",

  "score_label@common.label": {
    "text": "$score_text",
    "alpha": 0.0,
    "size": [ 0, 0 ],
    "visible": false
  },

  "sidebar_player_name": {
    "type": "label",
    "text": "$player_name",
    "color": "$scoreboard_color",
    "shadow": true,
    "size": [ "default", 10 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  "displayed_score_panel": {
    "type": "panel",
    "size": [ "100%c", 10 ],
    "controls": [
      {
        "sidebar_player_name@scoreboard.sidebar_player_name": {
          "shadow": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 2, 0 ]
        }
      }
    ]
  },

  "scoreboard_sidebar": {
    "type": "panel",
    "size": [ "100%c + 8px", "100%c + 6px" ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ -4, 0 ],
    "controls": [
      {
        "background@common.black_panel": {
          "alpha": 0.45,
          "size": [ "100%", "100%" ]
        }
      },
      {
        "content_panel": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "100%c", "100%c" ],
          "offset": [ 4, 3 ],
          "controls": [
            {
              "title_panel": {
                "type": "panel",
                "size": [ "100%c", 12 ],
                "controls": [
                  {
                    "sidebar_title@scoreboard.sidebar_title": {
                      "shadow": true,
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle"
                    }
                  }
                ]
              }
            },
            {
              "scores_panel": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100%c", "100%c" ],
                "bindings": [
                  {
                    "binding_name": "#scoreboard_scores",
                    "binding_name_override": "#collection_length"
                  }
                ],
                "controls": [
                  {
                    "row@scoreboard.displayed_score_panel": {
                      "size": [ "100%c", 10 ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
